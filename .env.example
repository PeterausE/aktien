# NICHT kopieren, nur als Template!
# Echte .env wird lokal auf dem Server erstellt und NICHT in Git committed.
# DB_HOST wird im Compose-Stack fest auf den mysql-Container gesetzt (siehe compose.yaml),
# hier nur relevant fuer lokale Entwicklung ausserhalb von Docker.

DB_HOST=localhost
DB_USER=aktien_user
DB_PASS=XXXX_SET_LOCALLY_XXXX
DB_NAME=aktien
MYSQL_ROOT_PASSWORD=XXXX_SET_LOCALLY_XXXX

MAIL_USER=XXXX_SET_LOCALLY_XXXX
MAIL_PASS=XXXX_SET_LOCALLY_XXXX

API_KEY_KURSE=XXXX_SET_LOCALLY_XXXX

JWT_SECRET=XXXX_SET_LOCALLY_XXXX
SESSION_TIMEOUT=28800

BENNI_PW_HASH=XXXX_bcrypt_hash_XXXX
PETER_PW_HASH=XXXX_bcrypt_hash_XXXX

PORT=3000
TZ=Europe/Berlin
