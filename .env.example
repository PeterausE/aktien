# NICHT kopieren, nur als Template!
# Echte .env wird lokal auf dem Server erstellt und NICHT in Git committed.
# DB_HOST wird im Compose-Stack fest auf den mysql-Container gesetzt (siehe compose.yaml),
# hier nur relevant fuer lokale Entwicklung ausserhalb von Docker.

DB_HOST=localhost
DB_USER=aktien_user
DB_PASS=XXXX_SET_LOCALLY_XXXX
DB_NAME=aktien
MYSQL_ROOT_PASSWORD=XXXX_SET_LOCALLY_XXXX

# SMTP-Versand-Zugang fuer das taegliche 09:00-Uhr-Briefing (backend/email.js) - Hostinger-
# Postfach info@gawborbeck.cloud, gleiches Vorgehen wie im ausstellung-app-Projekt.
# WICHTIG: Das ist NUR der Versand-Account, kein Empfaenger. Der Empfaenger des Briefings
# ist im Code fest auf peter.dewendt@gmx.de verdrahtet (siehe RECIPIENT in email.js) und
# darf NICHT aus einer Empfaengerliste eines anderen Projekts uebernommen werden.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=XXXX_SET_LOCALLY_XXXX
SMTP_PASSWORD=XXXX_SET_LOCALLY_XXXX
SMTP_FROM=info@gawborbeck.cloud

# Kursabfrage laeuft ueber inoffizielle Yahoo-Finance-Endpunkte (backend/prices.js) -
# kein API-Key noetig.

JWT_SECRET=XXXX_SET_LOCALLY_XXXX
SESSION_TIMEOUT=28800

BENNI_PW_HASH=XXXX_bcrypt_hash_XXXX
PETER_PW_HASH=XXXX_bcrypt_hash_XXXX

PORT=3000
TZ=Europe/Berlin
